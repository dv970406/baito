# ── Supabase (서버 전용) ─────────────────────────────────────────────
# Project URL — 대시보드 상단 「Connect」 버튼 또는 Settings → API Keys 상단 (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# 비밀 키 — Settings → API Keys 의 Secret keys(sb_secret_…) 또는 Legacy 탭의 service_role(eyJ…). 둘 다 동작.
# API Route 안에서만 쓰고 절대 클라이언트로 내보내지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# ── 데이터 백엔드 선택 (선택) ────────────────────────────────────────
# supabase | memory
# 비우면: Supabase 키가 있으면 supabase, 없으면 개발 환경에서는 memory, 프로덕션에서는 503 응답
BAITO_DATA_BACKEND=
